# ── Convex (프론트엔드) ─────────────────────────────────────────────────
# `npx convex dev` 최초 실행 시 자동 생성/주입됩니다.
CONVEX_DEPLOYMENT=
# 프론트엔드가 접속하는 Convex 배포 URL (예: https://your-project.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# ── Google 로그인 (Convex 배포 환경변수) ────────────────────────────────
# 아래 두 값은 .env.local 이 아니라 Convex 배포에 설정합니다:
#   npx convex env set AUTH_GOOGLE_ID <client-id>
#   npx convex env set AUTH_GOOGLE_SECRET <client-secret>
# Google Cloud 콘솔 OAuth 클라이언트의 승인된 리디렉션 URI:
#   https://<deployment>.convex.site/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── 통합(선택) — 없으면 데모 시드 데이터로 동작 ───────────────────────────
# 기자 매칭용 OpenCrab HTTP 엔드포인트/키 (미설정 시 시드 기자 DB 사용)
# Convex 배포에 설정: npx convex env set OPENCRAB_API_URL https://...
# POST JSON 계약: { query, pack_query, top_k } → { journalists: [{ reporter_name, outlet_name, email, ... }] }
OPENCRAB_API_URL=
OPENCRAB_API_KEY=
# 보도자료·메일 개인화 생성용 Anthropic 키 (미설정 시 템플릿 기반 생성)
# Convex: npx convex env set ANTHROPIC_API_KEY sk-ant-...
ANTHROPIC_API_KEY=
# Gmail(BYO-Email) 발송/초안 OAuth (미설정 시 초안 미리보기·발송 기록만) — 로그인용과 별개
# Google Cloud 승인된 리디렉션 URI: https://<deployment>.convex.site/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
